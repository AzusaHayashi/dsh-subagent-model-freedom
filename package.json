{
  "name": "dsh-subagent-model-freedom",
  "version": "0.1.0",
  "description": "让 DSH 子代理可以自由选择模型路由——新会话创建时自动注入 subagent/model-selection-policy，使 subagent 工具暴露 provider/model/reasoning_effort 参数。默认授权 WorkBuddy 免费模型，可配置任意 provider/model 路由。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://github.com/AzusaHayashi/dsh-subagent-model-freedom#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzusaHayashi/dsh-subagent-model-freedom.git"
  },
  "bugs": {
    "url": "https://github.com/AzusaHayashi/dsh-subagent-model-freedom/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "model-selection",
    "workbuddy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": false },
    "@deepseek-ai/dsh-session": { "optional": false },
    "@deepseek-ai/dsh-session-projection": { "optional": false }
  }
}
